# ---- HTTP server ----
PORT=8788
# Public HTTPS origin where this server is reachable (used in OAuth metadata).
PUBLIC_BASE_URL=https://mcp.lopningochlivet.se

# ---- Backend: Löpning & Livet API ----
# Base URL of the real Löpning & Livet REST API that this MCP server proxies.
LOPNING_LIVET_API_BASE_URL=https://api.lopningochlivet.se
# When true, tools return canned demo data and no backend/token is required.
USE_MOCK_BACKEND=true

# ---- OAuth 2.1 (Apps SDK requires user auth) ----
# The Authorization Server users log in against (Löpning & Livet's existing IdP).
OAUTH_ISSUER=https://auth.lopningochlivet.se
# The audience/resource value ChatGPT must request a token for. Usually PUBLIC_BASE_URL.
OAUTH_AUDIENCE=https://mcp.lopningochlivet.se
# JWKS endpoint for verifying access tokens (defaults to <issuer>/.well-known/jwks.json).
OAUTH_JWKS_URL=https://auth.lopningochlivet.se/.well-known/jwks.json
# Set to true only for local development against MCP Inspector without real tokens.
AUTH_DISABLED=false
